# Optional Apache / Hostinger clean URL rules
# Uncomment the lines below if you deploy on Hostinger and want to hide .html extensions.
# (GitHub Pages and Netlify ignore this file.)

# RewriteEngine On
# RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
# RewriteRule ^ /%1 [R=301,L]
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME}\.html -f
# RewriteRule ^(.*)$ $1.html [NC,L]
